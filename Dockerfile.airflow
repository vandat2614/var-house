# Start with the official Airflow image
FROM apache/airflow:2.10.0-python3.11

USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
         build-essential \
  && apt-get autoremove -yqq --purge \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

USER airflow

# Airflow only needs requests for crawling and confluent-kafka for the producer.
# We DO NOT install sqlmodel/pydantic here because they upgrade SQLAlchemy to 2.0 and crash Airflow.
RUN pip install --no-cache-dir requests>=2.31.0 confluent-kafka>=2.0.0 beautifulsoup4
